{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "@ui/*": ["./src/ui/*"],
      "@api/*": ["./src/api/*"],
      "@data/*": ["./src/data/*"],
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
