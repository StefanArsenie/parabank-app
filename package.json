{
  "name": "parabank-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:all:chromium": "playwright test --project=smoke --project=regression",
    "test:smoke": "playwright test --project=smoke --project=smoke-firefox --project=smoke-webkit",
    "test:regression": "playwright test --project=regression --project=regression-firefox --project=regression-webkit",
    "test:smoke-regression:all-browsers": "playwright test --grep \"@smoke|@regression\"",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:debug": "playwright test --project=chromium --debug",
    "clean": "rimraf allure-results test-results allure-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "reset-db": "curl -s http://localhost:8080/parabank/initializeDB.htm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
